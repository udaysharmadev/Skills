#!/usr/bin/env bash
# check-note — validate a scout research note's structure, not its truth.
# Truth needs a reader; structure is checkable: provenance header, pinned
# versions, sourced facts, uncertainty section. Usage: check-note <file>.
set -u
f="${1:-}"
if [ -z "$f" ] || [ ! -f "$f" ]; then
  echo "FAIL: usage: check-note <research-note.md>" >&2
  exit 2
fi
fail=0
head -n 3 "$f" | grep -q 'generated by scout on [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' \
  || { echo "FAIL $f: missing scout provenance header with date"; fail=1; }
grep -q '^\*\*Versions:\*\*' "$f" \
  || { echo "FAIL $f: missing '**Versions:**' pin line"; fail=1; }
grep -q '^## Load-bearing facts' "$f" \
  || { echo "FAIL $f: missing '## Load-bearing facts' section"; fail=1; }
grep -q '^## Uncertainty' "$f" \
  || { echo "FAIL $f: missing '## Uncertainty' section"; fail=1; }
# every fact line should carry evidence: a link, an inline-code path/pin,
# or an explicit unverified marker — a bare assertion is the failure mode.
facts=$(awk '/^## Load-bearing facts/{on=1; next} /^## /{on=0} on && /^- /' "$f")
if [ -z "$facts" ]; then
  echo "FAIL $f: no fact lines under Load-bearing facts"
  fail=1
else
  bad=0
  while IFS= read -r line; do
    case "$line" in
      *"http"*|*"unverified"*|*'`'*) ;;
      *) echo "FAIL $f: unsourced fact: $(echo "$line" | head -c 80)"; bad=1 ;;
    esac
  done <<EOF
$facts
EOF
  [ "$bad" -eq 1 ] && fail=1
fi
[ "$fail" -eq 0 ] && echo "OK: $f structure valid"
exit "$fail"
