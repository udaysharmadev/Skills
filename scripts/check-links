#!/usr/bin/env bash
# check-links — verify bundled skill paths and repository Markdown links.
set -u
cd "$(dirname "$0")/.."

fail=0

for f in skills/*/SKILL.md skills/*/references/*.md; do
  [ -f "$f" ] || continue
  dir=$(dirname "$f")

  # Bundled-folder paths mentioned anywhere in the body
  refs=$(grep -oE '(references|scripts|assets)/[A-Za-z0-9._/-]+' "$f" | sort -u || true)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ ! -e "$dir/$p" ]; then
      echo "FAIL $f: points at '$p' which does not exist"
      fail=1
    fi
  done <<EOF
$refs
EOF

  # Markdown links relative to the containing folder (skip http(s)/anchors)
  links=$(grep -oE '\]\([^)]+\)' "$f" | sed 's/^](//; s/)$//' | grep -vE '^(https?:|#)' | sort -u || true)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ ! -e "$dir/$p" ]; then
      echo "FAIL $f: markdown link target '$p' does not exist"
      fail=1
    fi
  done <<EOF
$links
EOF
done

# Public/repository Markdown links. External URLs are checked separately when
# network access exists; this pass guarantees that every local target resolves
# from the file containing the link. Fragments are allowed and stripped here.
while IFS= read -r f; do
  dir=$(dirname "$f")
  links=$(grep -oE '\]\([^)]+\)' "$f" | sed 's/^](//; s/)$//' \
    | grep -vE '^(https?:|mailto:|#)' | sort -u || true)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    p=${p%%#*}
    p=${p%%\?*}
    p=${p#<}
    p=${p%>}
    [ -n "$p" ] || continue
    if [ ! -e "$dir/$p" ]; then
      echo "FAIL $f: markdown link target '$p' does not exist"
      fail=1
    fi
  done <<EOF
$links
EOF
done <<EOF
$(find . -type f -name '*.md' -not -path './.git/*' | sort)
EOF

if [ "$fail" -eq 0 ]; then
  echo "OK: all bundled paths and inline local Markdown file targets exist"
fi
exit "$fail"
