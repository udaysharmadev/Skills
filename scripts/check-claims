#!/usr/bin/env bash
# check-claims — every row in docs/claims.md must be well-formed per
# shared/schemas/claim.md, and MEASURED/FACT rows must point at evidence.
# Release-critical: no public number without a row.
set -u
cd "$(dirname "$0")/.."

fail=0
claims="docs/claims.md"

if [ ! -f "$claims" ]; then
  echo "FAIL: docs/claims.md missing — no public metric may ship without it"
  exit 1
fi

# data rows: lines starting with "| C-"
rows=$(grep -cE '^\| C-[0-9]+' "$claims" || true)
if [ "$rows" -eq 0 ]; then
  echo "FAIL: docs/claims.md contains no claim rows"
  exit 1
fi

while IFS= read -r line; do
  id=$(echo "$line" | awk -F'|' '{print $2}' | tr -d ' ')
  class=$(echo "$line" | awk -F'|' '{print $4}' | tr -d ' ')
  evidence=$(echo "$line" | awk -F'|' '{print $5}' | sed 's/^ *//; s/ *$//')
  verified=$(echo "$line" | awk -F'|' '{print $6}' | tr -d ' ')
  case "$class" in
    FACT|MEASURED|DERIVED|ESTIMATED|TARGET|UNVERIFIED) ;;
    *) echo "FAIL $id: unknown class '$class'"; fail=1; continue ;;
  esac
  case "$class" in
    FACT|MEASURED|DERIVED)
      if [ "$evidence" = "—" ] || [ -z "$evidence" ]; then
        echo "FAIL $id ($class): missing evidence path"
        fail=1
      fi
      if [ "$verified" = "—" ] || [ -z "$verified" ]; then
        echo "FAIL $id ($class): missing verified date"
        fail=1
      fi
      ;;
  esac
done <<EOF
$(grep -E '^\| C-[0-9]+' "$claims")
EOF

# Backticked repository paths in evidence cells must resolve. Free-text
# evidence (for example, a clean-directory install log) remains allowed.
if ! python3 - "$claims" <<'PY'
import glob
import json
import re
import subprocess
import sys
from pathlib import Path

root = Path.cwd()
rows = {}
failed = False
for line in Path(sys.argv[1]).read_text().splitlines():
    if not re.match(r"^\| C-\d+", line):
        continue
    cells = [cell.strip() for cell in line.split("|")[1:-1]]
    claim_id, statement, _, evidence = cells[:4]
    rows[claim_id] = statement
    for reference in re.findall(r"`([^`]+)`", evidence):
        looks_like_path = "/" in reference or reference.endswith(
            (".md", ".json", ".py", ".sh")
        )
        if not looks_like_path:
            continue
        matches = glob.glob(str(root / reference))
        if not matches:
            print(f"FAIL {claim_id}: evidence path does not resolve: {reference}")
            failed = True

context = json.loads(subprocess.check_output(
    [str(root / "scripts/check-context"), "--json"], text=True
))
expected = (
    f"{context['totals']['skill_md_bytes'] // 1024}KB",
    f"{context['totals']['description_tokens']} tok",
)
statement = rows.get("C-009", "")
for value in expected:
    if value not in statement:
        print(f"FAIL C-009: context claim is stale; expected {value}")
        failed = True

sys.exit(1 if failed else 0)
PY
then
  fail=1
fi

# banned hype: these words must not appear in README without a claim row
for word in "supercharge" "revolutionize" "unlock the power" "10x developer"; do
  if grep -qi -- "$word" README.md; then
    echo "FAIL README.md contains hype phrase '$word' with no claim row"
    fail=1
  fi
done

if [ "$fail" -eq 0 ]; then
  echo "OK: $rows claim row(s) well-formed"
fi
exit "$fail"
