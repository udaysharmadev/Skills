#!/usr/bin/env bash
# Validate the 28-skill product contract with cheap deterministic checks.
set -u
cd "$(dirname "$0")/.."

fail=0
expected="backend blueprint cleared concierge distill ditto findable friction frontpage frugal handsfree harden headroom hotpath hotseat janitor masterplan pilot polish proof recall referee roadtest runway scout sleuth spelunk unslop"
count=0

scripts/validate-frontmatter || fail=1

for dir in skills/*/; do
  [ -d "$dir" ] || continue
  count=$((count + 1))
  skill=$(basename "$dir")
  file="$dir/SKILL.md"

  case " $expected " in
    *" $skill "*) ;;
    *) echo "FAIL $skill: outside the frozen 28-skill set"; fail=1 ;;
  esac

  lines=$(wc -l < "$file" | tr -d ' ')
  if [ "$lines" -gt 500 ]; then
    echo "FAIL $skill: SKILL.md has $lines lines; maximum is 500"
    fail=1
  fi

  for heading in "When NOT to use" "Quality gates" "Stop conditions" "Output contract"; do
    if ! grep -q "^## $heading" "$file"; then
      echo "FAIL $skill: missing '$heading'"
      fail=1
    fi
  done

  for heading in "Prerequisites" "Tool selection"; do
    if ! grep -Eqi "^## .*$heading" "$file"; then
      echo "FAIL $skill: missing '$heading' guidance"
      fail=1
    fi
  done

  research="$dir/references/research.md"
  if [ ! -f "$research" ]; then
    echo "FAIL $skill: missing references/research.md"
    fail=1
  else
    for field in "Title:" "Author / Organization:" "Publication date:" "Version:" "URL:" "Source type:" "What it establishes:" "What this skill adopts:" "What it does NOT establish:" "Numbers taken from source:" "Reverify when:"; do
      if ! grep -Fq "$field" "$research"; then
        echo "FAIL $skill: research ledger missing '$field'"
        fail=1
      fi
    done
    if ! grep -Eq '^Source type: (standard|primary research|official docs|implementation evidence)$' "$research"; then
      echo "FAIL $skill: research ledger has an unsupported source type"
      fail=1
    fi
    if ! grep -Fq "references/research.md" "$file"; then
      echo "FAIL $skill: research ledger is not discoverable from SKILL.md"
      fail=1
    fi
  fi

  if grep -REqn '\]\(\.\./|\]\(/|(^|[^[:alnum:]_])shared/' "$dir"; then
    echo "FAIL $skill: runtime package depends outside its own folder"
    fail=1
  fi

  for helper in "$dir"scripts/*; do
    [ -f "$helper" ] || continue
    if [ ! -x "$helper" ]; then
      echo "FAIL $skill: helper $helper is not executable"
      fail=1
    fi
  done
done

if [ "$count" -ne 28 ]; then
  echo "FAIL: expected exactly 28 skills, found $count"
  fail=1
fi

em_dash=$(printf '\342\200\224')
if rg -n "$em_dash" skills >/dev/null; then
  echo "FAIL: literal em dash found in shipped skill text"
  rg -n "$em_dash" skills
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  echo "OK: $count self-contained skills satisfy the repository contract"
fi
exit "$fail"
