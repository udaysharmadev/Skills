#!/usr/bin/env bash
# validate-frontmatter — spec-strict frontmatter check per skill
# (agentskills.io: name 1-64 chars, lowercase alnum+hyphens, no
# leading/trailing/double hyphen, must match parent dir; description
# 1-1024 chars, non-empty; optional license/compatibility/metadata caps).
# validate-skills covers presence/shape; this covers spec legality.
set -u
cd "$(dirname "$0")/.."

fail=0
count=0

for dir in skills/*/; do
  [ -d "$dir" ] || continue
  count=$((count + 1))
  name=$(basename "$dir")
  f="$dir/SKILL.md"

  # extract frontmatter block (between the two --- delimiters)
  fm=$(awk 'NR==1 && /^---$/{on=1; next} on && /^---$/{exit} on{print}' "$f")

  fm_name=$(echo "$fm" | awk '/^name:/{sub(/^name: */,""); print; exit}')
  if [ ${#fm_name} -lt 1 ] || [ ${#fm_name} -gt 64 ]; then
    echo "FAIL $name: frontmatter name length ${#fm_name} (spec: 1-64)"
    fail=1
  fi
  if ! echo "$fm_name" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo "FAIL $name: frontmatter name '$fm_name' violates spec charset (lowercase alnum, hyphens only, no leading/trailing/double hyphen)"
    fail=1
  fi

  desc=$(echo "$fm" | awk '/^description:/{sub(/^description: */,""); print; exit}')
  if [ -z "$desc" ]; then
    echo "FAIL $name: empty description (spec: 1-1024 non-empty)"
    fail=1
  elif [ "${#desc}" -gt 1024 ]; then
    echo "FAIL $name: description ${#desc} chars (spec limit 1024)"
    fail=1
  fi

  compat=$(echo "$fm" | awk '/^compatibility:/{sub(/^compatibility: */,""); print; exit}')
  if [ -n "$compat" ] && [ "${#compat}" -gt 500 ]; then
    echo "FAIL $name: compatibility ${#compat} chars (spec limit 500)"
    fail=1
  fi

  # unknown top-level frontmatter keys are a drift smell (spec + local set)
  while IFS= read -r key; do
    case "$key" in
      name|description|license|compatibility|metadata|allowed-tools) ;;
      *) echo "FAIL $name: unknown frontmatter key '$key'"; fail=1 ;;
    esac
  done <<EOF
$(echo "$fm" | grep -E '^[A-Za-z][A-Za-z0-9_-]*:' | sed 's/:.*//' | sort -u)
EOF
done

if [ "$fail" -eq 0 ]; then
  echo "OK: $count frontmatter block(s) spec-legal"
fi
exit "$fail"
