#!/usr/bin/env bash
# Validate the deliberately small YAML subset used by this repository.
set -u
cd "$(dirname "$0")/.."

fail=0
count=0

for dir in skills/*/; do
  [ -d "$dir" ] || continue
  count=$((count + 1))
  skill=$(basename "$dir")
  file="$dir/SKILL.md"

  if [ ! -f "$file" ]; then
    echo "FAIL $skill: missing SKILL.md"
    fail=1
    continue
  fi

  if [ "$(head -n 1 "$file")" != "---" ]; then
    echo "FAIL $skill: frontmatter must start on line 1"
    fail=1
    continue
  fi

  close=$(awk 'NR > 1 && /^---$/ { print NR; exit }' "$file")
  if [ -z "$close" ]; then
    echo "FAIL $skill: frontmatter is not closed"
    fail=1
    continue
  fi

  fm=$(sed -n "2,$((close - 1))p" "$file")
  if echo "$fm" | grep -qvE '^(name|description): [^[:space:]].*$'; then
    echo "FAIL $skill: frontmatter must contain only single-line name and description scalars"
    fail=1
  fi

  keys=$(printf '%s\n' "$fm" | sed 's/:.*//' | sort)
  if [ "$keys" != "$(printf 'description\nname')" ]; then
    echo "FAIL $skill: frontmatter requires exactly one name and one description"
    fail=1
  fi

  name=$(printf '%s\n' "$fm" | sed -n 's/^name: //p')
  desc=$(printf '%s\n' "$fm" | sed -n 's/^description: //p')

  if ! printf '%s\n' "$name" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo "FAIL $skill: invalid name '$name'"
    fail=1
  elif [ "$name" != "$skill" ]; then
    echo "FAIL $skill: name '$name' does not match directory"
    fail=1
  fi

  if [ ${#name} -gt 64 ]; then
    echo "FAIL $skill: name exceeds 64 characters"
    fail=1
  fi
  if [ -z "$desc" ] || [ ${#desc} -gt 1024 ]; then
    echo "FAIL $skill: description must contain 1 to 1024 characters"
    fail=1
  fi
  if ! printf '%s\n' "$desc" | grep -Eqi 'use (when|for|before)|when '; then
    echo "FAIL $skill: description does not state when to use the skill"
    fail=1
  fi
done

if command -v skills-ref >/dev/null 2>&1; then
  for dir in skills/*/; do
    skills-ref validate "$dir" || fail=1
  done
else
  echo "INFO: skills-ref unavailable; local strict validation completed"
fi

if [ "$fail" -eq 0 ]; then
  echo "OK: $count frontmatter blocks are strict and spec-shaped"
fi
exit "$fail"
