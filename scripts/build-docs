#!/usr/bin/env bash
# build-docs — regenerate docs/skills/INDEX.md from skill frontmatter.
# Run after any frontmatter change; the index is generated, not hand-edited.
set -u
cd "$(dirname "$0")/.."

mkdir -p docs/skills
out="docs/skills/INDEX.md"

{
  echo "# Skill index"
  echo
  echo "<!-- generated by scripts/build-docs — do not edit by hand -->"
  echo
  # Lifecycle order matches the human guide and README. Keep the source list
  # explicit so a new folder cannot silently enter the frozen public set.
  for name in \
    concierge hotseat spelunk scout distill masterplan recall \
    pilot backend blueprint headroom \
    polish friction ditto \
    proof roadtest sleuth referee hotpath harden \
    unslop janitor frontpage findable frugal \
    cleared runway; do
    f="skills/$name/SKILL.md"
    [ -f "$f" ] || continue
    fm_name=$(awk 'NR>1 && /^---$/{exit} /^name:/{print $2; exit}' "$f")
    desc=$(awk 'NR>1 && /^---$/{exit} /^description:/{sub(/^description: */,""); print; exit}' "$f")
    echo "- **\`$fm_name\`** — $desc"
    echo
  done
} > "$out"

echo "OK: wrote $out ($(grep -c '^-' "$out") skills)"
