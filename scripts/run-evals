#!/usr/bin/env bash
# run-evals — validate trigger-eval FIXTURES (format + slugs exist).
# Measurement happens separately via scripts/eval-trigger (live agents,
# provenance-stamped JSON in evals/results/). This script only guarantees
# the fixtures are well-formed and point at real skills.
#
# Fixture contract (evals/trigger/cases.md):
#   - blank lines, `#` headings and `>` blockquote prose are skipped;
#   - a case line is a bullet: - "utterance" => <slug>|none
#   - any other line containing => is a malformed case (fail);
#   - any other line is prose and ignored.
set -u
cd "$(dirname "$0")/.."

# all trigger suites are validated; see evals/trigger/
fail=0


total=0
for cases_file in evals/trigger/*.md; do
  [ -f "$cases_file" ] || continue
  while IFS= read -r line; do
  case "$line" in
    ''|'#'*|'>'*) continue ;;
  esac

  if [ "${line#- \"}" != "$line" ]; then
    # Looks like a case bullet — it must match the full case format.
    total=$((total + 1))
    if ! echo "$line" | grep -qE '^- "[^"]+" => ([a-z][a-z0-9]+|none|[a-z0-9]+(→[a-z][a-z0-9]*)+)$'; then
      echo "FAIL: malformed case line in $cases_file: $line"
      fail=1
      continue
    fi
    slug=$(echo "$line" | sed 's/.*=> *//')
    if [ "$slug" != "none" ]; then
      IFS='→' read -r -a slugs <<< "$slug"
      for s in "${slugs[@]}"; do
        if [ ! -d "skills/$s" ]; then
          echo "FAIL: case targets unknown skill '$s': $line"
          fail=1
        fi
      done
    fi
  elif echo "$line" | grep -q '=>'; then
    echo "FAIL: stray => outside a case bullet: $line"
    fail=1
  fi
  done < "$cases_file"
done

if [ "$total" -lt 10 ]; then
  echo "FAIL: only $total cases — each skill needs positive AND negative trigger cases"
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  echo "OK: $total trigger cases well-formed across all suites (measurement: scripts/eval-trigger)"
fi
exit "$fail"
