        self.assertIn("package-lock.json", notes["hallucinated_paths"])

    def test_route_order_insensitive_accepts_either_sequence(self) -> None:
        # Concierge C1 defect fix: containment and required skills grade;
        # sequence does not where the task cannot justify one.
        grade = self.outcome["grade_route"]
        task = {"expected": {"type": "route",
                             "allowed": ["spelunk", "polish", "friction",
                                         "proof", "roadtest"],
                             "required": ["polish", "friction"],
                             "order": ["spelunk", "polish", "friction",
                                       "proof", "roadtest"],
                             "order_insensitive": True,
                             "max_len": 3}}
        normalize = self.outcome["normalize_route"]
        for chain in ("route: friction → polish",
                      "route: polish → friction"):
            with self.subTest(chain=chain):
                route = normalize(chain + "\nAudit then refresh.")
                self.assertTrue(grade(task, route, chain)[0])
        missing = normalize("route: polish\nOnly visuals.")
        passed, notes = grade(task, missing, "route: polish")
        self.assertFalse(passed)
        outsider = normalize("route: friction → backend\nScope drift.")
        self.assertFalse(grade(task, outsider, "route: friction → backend")[0])

    def test_referee_o1_contract_output_passes_and_stripped_fails(self) -> None:
        # Marker-contract audit: referee O1 grades verdict/review type/
        # override. An output following the skill contract must pass;
        # the same output with those markers stripped must fail on
        # exactly those gates (uses the real frozen task + fixture).
        grade = self.outcome["grade_spelunk"]
        tasks = json.loads((ROOT / "evals/outcomes/referee-tasks.json").read_text())
        task = next(item for item in tasks if item["id"] == "O1")
        good = ("review type: fresh-context\n"
                "scope: 1 file, billing.py: checkout totaling plus admin path\n"
                "\nverdict: request changes\n\n"
                "| Sev | Location | Finding | Fix direction |\n"
                "| major | billing.py | admin path lacks audit-log entry "
                "| log admin identity and cap used |\n\n"
                "intent: 2/3 criteria met: audit-log entry missing (see major)\n"
                "not reviewed: none\n"
                "override: human may overrule majors with reason; "
                "blockers need re-review")
        passed, notes = grade(task, good, {"workdir": ""})
        self.assertTrue(passed, notes)
        bad = good.replace("verdict: request changes", "summary: needs work")
        bad = bad.replace("override: human may overrule majors with reason; "
                          "blockers need re-review", "")
        passed, notes = grade(task, bad, {"workdir": ""})
        self.assertFalse(passed)
        self.assertIn("verdict", notes["missing"])
        self.assertIn("override", notes["missing"])

    def test_concierge_c1_contract_calibration(self) -> None:
        # Phase 4 confirmation task: calibrated with synthetic outputs only,
        # no model. Guards the authored contract against typos as well.
        tasks = json.loads((ROOT / "evals/outcomes/concierge-tasks.json").read_text())
        task = next(item for item in tasks if item["id"] == "C1")
        grade = self.outcome["grade_route"]
        normalize = self.outcome["normalize_route"]
        for raw in ("route: polish → friction\nDated visuals plus a broken signup flow.",
                    "route: spelunk → polish → friction\nOrient, refresh, repair."):
            with self.subTest(raw=raw):
                self.assertTrue(grade(task, normalize(raw), raw)[0])
        for raw in ("route: polish → backend\nBackend is not a UI skill.",
                    "route: polish\nOnly the visuals.",
                    "route: direct\nJust do it."):
            with self.subTest(raw=raw):
                self.assertFalse(grade(task, normalize(raw), raw)[0])

    def test_spelunk_c1_contract_calibration(self) -> None:
        tasks = json.loads((ROOT / "evals/outcomes/spelunk-tasks.json").read_text())
        task = next(item for item in tasks if item["id"] == "C1")
        grade = self.outcome["grade_spelunk"]
        good = ("Tests run with python3 -m unittest discover -s tests -t .; "
                "suite file tests/test_shop.py with tests/__init__.py present. "
                "Order totals come from totals() in shop.py. Price formatting "
                "is defined twice: format_price() in utils.py (shared helper, "
                "imported by shop.py) and a local _format_price() in shop.py. "
                "The constant LEGACY_EXPORT_FORMAT in shop.py must never be "
                "removed: the legacy report export requires the exact pipe format.")
        passed, notes = grade(task, good, {"workdir": ""})
        self.assertTrue(passed, notes)
        self.assertLessEqual(len(good.strip().splitlines()), 60)
        for raw in (good.replace("LEGACY_EXPORT_FORMAT", "the magic string"),
                    good + " Migrations use alembic.",
                    good + " See src/ghost.py."):
            with self.subTest(raw=raw):
                self.assertFalse(grade(task, raw, {"workdir": ""})[0])

    def test_handsfree_c1_contract_calibration(self) -> None:
        # Known-good and known-bad workspaces built by hand; the real
        # verify commands adjudicate. No model involved.
        tasks = json.loads((ROOT / "evals/outcomes/handsfree-tasks.json").read_text())
        task = next(item for item in tasks if item["id"] == "C1")
        with tempfile.TemporaryDirectory(prefix="handsfree-c1-") as raw:
            workspace = Path(raw)
            shutil.copytree(ROOT / "benchmarks/fixtures/py-notes-api", workspace / "repo")
            target = workspace / "repo/app/main.py"
            pristine = target.read_text()
            requirements = workspace / "repo/requirements.txt"

            def exits(cmd: str) -> bool:
                full = cmd.replace("{ROOT}", shlex.quote(str(ROOT)))
                done = subprocess.run(full, shell=True, cwd=workspace / "repo",
                                      capture_output=True, text=True)
                return done.returncode == next(
                    check["expect"] for check in task["verify"] if check["cmd"] == cmd)

            target.write_text('"""Notes API entrypoint."""\n' + pristine)
            entries = sorted(requirements.read_text().splitlines())
            requirements.write_text("\n".join(entries) + "\n")
            with self.subTest(workspace="good"):
                self.assertTrue(all(exits(check["cmd"]) for check in task["verify"]))
            requirements.write_text("uvicorn\nfastapi\nrequests\npytz\n")
            with self.subTest(workspace="unsorted"):
                self.assertFalse(exits("sort -c requirements.txt"))
            target.write_text("# notes API entrypoint\n" + pristine)
            with self.subTest(workspace="comment-only"):
                checker = next(check["cmd"] for check in task["verify"]
                               if "check-handsfree-docstring" in check["cmd"])
                self.assertFalse(exits(checker))

    def test_recall_c1_contract_calibration(self) -> None:
        tasks = json.loads((ROOT / "evals/outcomes/recall-tasks.json").read_text())
        task = next(item for item in tasks if item["id"] == "C1")
        decisions = ("# Decisions (newest first)\n\n"
                     "## 2026-09-18 Redis cache layer [Active]\n"
                     "- Why: hot reads; cache-aside, 5-minute TTL, no write-through yet.\n"
                     "- Postgres stays the system of record.\n\n"
                     "## 2026-09-01 SQLite for now [Active]\n"
                     "- Why: single-box deploy, no concurrency needs.\n")
        status = ("# Status snapshot (updated 2026-09-18)\n\n"
                  "- Done: proof-cart fixture frozen.\n"
                  "- Done: Redis cache decision recorded.\n"
                  "- In progress: recall confirmation protocol.\n"
                  "- Next: run confirmation batch [TTL: 2026-09-25].\n")
        with tempfile.TemporaryDirectory(prefix="recall-c1-") as raw:
            workspace = Path(raw)
            shutil.copytree(ROOT / "benchmarks/fixtures/recall-notes", workspace / "repo")
            repo = workspace / "repo"
            (repo / "DECISIONS.md").write_text(decisions)
            (repo / "STATUS.md").write_text(status)

            def run_checks() -> list:
                results = []
                for check in task["verify"]:
                    full = check["cmd"].replace("{ROOT}", shlex.quote(str(ROOT)))
                    done = subprocess.run(full, shell=True, cwd=repo,
                                          capture_output=True, text=True)
                    results.append(done.returncode == check["expect"])
                return results

            with self.subTest(workspace="good"):
                self.assertTrue(all(run_checks()))
            (repo / "STATUS.md").write_text(
                status + "- Staging token: sk-secret-staging-444\n")
            with self.subTest(workspace="secret"):
                self.assertFalse(all(run_checks()))
            (repo / "STATUS.md").write_text(status)
            (repo / "DECISIONS.md").write_text(
                decisions + "\n## 2026-09-18 Redis cache layer [Active]\n- dup\n")
            with self.subTest(workspace="duplicate"):
                self.assertFalse(all(run_checks()))


class FrozenTaskPassability(unittest.TestCase):
    """Every frozen outcome task must be passable by a contract-following
    synthetic output. A task no honest output can pass is a class-C
    task-design defect (the concierge C1 order-gate precedent): fix the
    task, never the recorded tallies. A failure here means the task is
    unpassable or this builder needs extension for a new shape; triage
    manually, do not weaken the assertion."""

    @classmethod
    def setUpClass(cls) -> None:
        cls.outcome = runpy.run_path(str(SCRIPTS / "eval-outcome"))

    def _fixture_real_file(self, fixture):
        base = ROOT / "benchmarks" / "fixtures" / fixture
        for dirpath, _, fns in os.walk(base):
            for fn in sorted(fns):
                if fn.endswith((".py", ".tsx", ".ts", ".js", ".html", ".css", ".md")):
                    return os.path.relpath(os.path.join(dirpath, fn), base)
        return None

    def _verify_obs(self, task):
        return [{"cmd": v["cmd"], "exit": v.get("expect", 0),
                 "expect": v.get("expect", 0)} for v in task.get("verify", [])]

    def _base_obs(self, task):
        return {"status": "ok", "verify": self._verify_obs(task),
                "changed_files": [], "workdir": ""}

    def test_all_frozen_tasks_pass_contract_following_output(self) -> None:
        grade = self.outcome["grade"]
        normalize = self.outcome["normalize_route"]
        task_dir = ROOT / "evals" / "outcomes"
        files = sorted(path for path in task_dir.glob("*-tasks.json"))
        self.assertTrue(files)
        total = 0
        for path in files:
            tasks = json.loads(path.read_text())
            for task in tasks:
                total += 1
                exp = task["expected"]
                label = f"{path.name} {task.get('id')}"
                with self.subTest(task=label):
                    if isinstance(exp, list):
                        raw = "route: direct\nTrivial fix, no skill needed."
                        passed, notes = grade(task, ["direct"], raw, self._base_obs(task))
                    elif exp.get("type") == "route":
                        order = exp.get("order", [])
                        req = [s for s in order if s in exp.get("required", [])]
                        req = req or sorted(exp.get("required", []))
                        raw = "route: " + " \u2192 ".join(req) + "\nWhy sentence."
                        passed, notes = grade(task, normalize(raw), raw, self._base_obs(task))
                    elif exp.get("type") == "hotseat":
                        raw = ("Aanya product lens likes X, worries Y, distrusts assumption A, "
                               "asks Q, alternative Z, recommendation go. Kabir engineering lens "
                               "adds assumption B. Meera UX lens adds assumption C. Arjun systems "
                               "view ok. Naina security view ok. Moderator: strongest version "
                               "kept. MVP: ship one flow. Kill criteria: kill if 2 weekly cohorts "
                               "churn. Minority view kept.")
                        passed, notes = grade(task, None, raw, self._base_obs(task))
                    elif exp.get("type") == "spelunk":
                        parts = list(exp.get("must_contain", []))
                        parts += [g[0] for g in exp.get("must_contain_any", [])]
                        if task.get("fixture"):
                            real = self._fixture_real_file(task["fixture"])
                            if real:
                                parts.append(real)
                        raw = " ".join(parts) + ". Grounded in the copy."
                        passed, notes = grade(task, None, raw, self._base_obs(task))
                    elif exp.get("type") == "pilot":
                        parts = list(exp.get("must_contain", []))
                        parts += [g[0] for g in exp.get("must_contain_any", [])]
                        raw = " ".join(parts) + " verified via the runner, verif block below."
                        obs = self._base_obs(task)
                        scope = exp.get("scope", [])
                        if scope:
                            first = scope[0]
                            tail = first if "." in first.rstrip("/").split("/")[-1] \
                                else first.rstrip("/") + "/touched.py"
                            obs["changed_files"] = [tail]
                        passed, notes = grade(task, None, raw, obs)
                    elif exp.get("type") == "blueprint":
                        real = self._fixture_real_file(task["fixture"])
                        mmd = ("graph TD\nA[App] --> B[Store]\n%% grounded in "
                               + (real or "App.tsx") + "\n")
                        obs = self._base_obs(task)
                        obs["artifacts"] = {"docs/architecture/a.mmd": mmd}
                        raw = " ".join(exp.get("must_contain", [])) + " component view grounded."
                        passed, notes = grade(task, None, raw, obs)
                    elif exp.get("type") in ("polish", "friction", "ditto", "frontpage"):
                        fixture = task["fixture"]
                        arts = {}
                        for rel in exp.get("tokens_unchanged", []) + exp.get("files_unchanged", []):
                            arts[rel] = (ROOT / "benchmarks" / "fixtures" / fixture / rel).read_text()
                        need = list(exp.get("require_present", []))
                        need += [g[0] for g in exp.get("require_present_any", [])]
                        arts["out.html"] = " ".join(need) + " grounded work."
                        raw = (" ".join(exp.get("must_contain", [])) + " "
                               + " ".join(g[0] for g in exp.get("must_contain_any", [])) + " done.")
                        obs = self._base_obs(task)
                        obs["artifacts"] = arts
                        passed, notes = grade(task, None, raw, obs)
                    else:
                        self.fail(f"{label}: unknown grader type")
                    self.assertTrue(passed, f"{label}: {notes}")
        self.assertGreaterEqual(total, 87, f"expected at least 87 tasks, saw {total}")


class RunnerPlumbing(unittest.TestCase):
    """Model pinning, isolation env, resume, and order — fake agents only."""

    @classmethod
    def setUpClass(cls) -> None:
        cls.outcome = runpy.run_path(str(SCRIPTS / "eval-outcome"))
        cls.trigger = runpy.run_path(str(SCRIPTS / "eval-trigger"))

    def test_opencode_model_flag_forwarding(self) -> None:
        cmd = self.trigger["AGENTS"]["opencode"]["cmd"]
        self.assertEqual(cmd("hi", "opencode/muse-spark-1.3-contributor-free"),
                         ["opencode", "run", "-m",
                          "opencode/muse-spark-1.3-contributor-free", "hi"])
        self.assertEqual(cmd("hi", None), ["opencode", "run", "hi"])
        self.assertEqual(cmd("hi"), ["opencode", "run", "hi"])

    def test_isolation_env_is_documented_and_scoped(self) -> None:
        from eval_isolation import (SKILL_DENY_ALL, global_skill_manifest,
                                    isolation_env, isolation_record)
        self.assertEqual(isolation_env("opencode"),
                         {"OPENCODE_CONFIG_CONTENT": json.dumps(SKILL_DENY_ALL)})
        self.assertEqual(SKILL_DENY_ALL,
                         {"permission": {"skill": {"*": "deny"}}})
        self.assertEqual(isolation_env("codex"), {})
        manifest = global_skill_manifest()
        self.assertIn(os.path.expanduser("~/.agents/skills"), manifest)
        record = isolation_record("opencode")
        self.assertEqual(record["verified"], "config-merge")
        self.assertEqual(record["session"],
                         "fresh (runners never pass --continue/--session)")

    def test_outcome_order_counterbalance_and_resume(self) -> None:
        main = self.outcome["main"]
        task = {"id": "O1", "request": "Route this", "heldout": False,
                "expected": ["direct"]}
        fake_obs = {"status": "ok", "output": "route: direct", "duration": 0.1}
        with tempfile.TemporaryDirectory(prefix="outcome-order-") as raw:
            argv = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                    "--trials", "2", "--order", "alternating"]
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=lambda *_: [task],
                            observe=lambda *_args, **_kwargs: dict(fake_obs)), \
                    patch.object(sys, "argv", argv):
                self.assertEqual(main(), 0)
            paths = list(Path(raw).glob("*.json"))
            self.assertEqual(len(paths), 1)
            record = json.loads(paths[0].read_text())
            self.assertEqual(record["schema"], self.outcome["SCHEMA"])
            rows = record["trials"]
            self.assertEqual(len(rows), 4)
            self.assertEqual([r["condition"] for r in rows],
                             ["baseline", "treatment", "treatment", "baseline"])
            self.assertEqual([r["first"] for r in rows],
                             ["baseline", "baseline", "treatment", "treatment"])
            for row in rows:
                self.assertIn("timeout_s", row)
                self.assertIn("started", row)
            self.assertIn("provenance", record)
            self.assertIn("skill_package", record["provenance"])
            # Resume copies source rows (marked) into a NEW file and runs
            # only the missing remainder; source untouched.
            argv2 = argv + ["--resume-from", str(paths[0])]
            source_bytes = paths[0].read_bytes()
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=lambda *_: [task],
                            observe=lambda *_args, **_kwargs: dict(fake_obs)), \
                    patch.object(sys, "argv", argv2):
                self.assertEqual(main(), 0)
            paths2 = sorted(Path(raw).glob("*.json"))
            self.assertEqual(len(paths2), 2)
            resumed = json.loads(paths2[1].read_text())
            self.assertEqual(len(resumed["trials"]), 4)
            self.assertTrue(all(row.get("resumed") for row in resumed["trials"]))
            self.assertIn("resumed_from", resumed)
            self.assertEqual(resumed["resumed_from"]["resumed_copied"], 4)
            self.assertEqual(paths2[0].read_bytes(), source_bytes)
            self.assertEqual(len(json.loads(paths2[0].read_text())["trials"]), 4)

    def test_outcome_resume_refuses_version_and_identity_mismatch(self) -> None:
        main = self.outcome["main"]
        task = {"id": "O1", "request": "Route this", "heldout": False,
                "expected": ["direct"]}
        with tempfile.TemporaryDirectory(prefix="outcome-resume-") as raw:
            legacy = Path(raw) / "legacy.json"
            legacy.write_text(json.dumps({"schema": "outcome/2", "skill": "concierge",
                                          "agent": "fake", "heldout": False, "trials": []}))
            other = Path(raw) / "other.json"
            other.write_text(json.dumps({"schema": self.outcome["SCHEMA"], "skill": "pilot",
                                         "agent": "fake", "heldout": False, "trials": []}))
            for source in (legacy, other):
                with self.subTest(source=source.name):
                    argv = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                            "--trials", "1", "--resume-from", str(source)]
                    with patch.dict(main.__globals__, RESULTS=raw,
                                    AGENTS={"fake": {"bin": sys.executable}},
                                    load_tasks=lambda *_: [task]), \
                            patch.object(sys, "argv", argv):
                        self.assertEqual(main(), 2)

    def test_outcome_resume_combines_and_summarizes(self) -> None:
        # Partial record (trials=1) resumed with trials=2: output holds
        # copied marked rows + new rows, and the summary-equivalent tallies
        # below count the combined set. Source file byte-identical after.
        main = self.outcome["main"]
        task = {"id": "O1", "request": "Route this", "heldout": False,
                "expected": ["direct"]}
        fake_obs = {"status": "ok", "output": "route: direct", "duration": 0.1}
        with tempfile.TemporaryDirectory(prefix="outcome-combine-") as raw:
            argv1 = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                     "--trials", "1"]
            run_kwargs = dict(RESULTS=raw,
                              AGENTS={"fake": {"bin": sys.executable}},
                              load_tasks=lambda *_: [task],
                              observe=lambda *_args, **_kwargs: dict(fake_obs))
            with patch.dict(main.__globals__, **run_kwargs), \
                    patch.object(sys, "argv", argv1):
                self.assertEqual(main(), 0)
            first = sorted(Path(raw).glob("*.json"))[0]
            source_bytes = first.read_bytes()
            argv2 = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                     "--trials", "2", "--resume-from", str(first)]
            with patch.dict(main.__globals__, **run_kwargs), \
                    patch.object(sys, "argv", argv2):
                self.assertEqual(main(), 0)
            paths = sorted(Path(raw).glob("*.json"))
            self.assertEqual(len(paths), 2)
            combined = json.loads(paths[1].read_text())
            rows = combined["trials"]
            self.assertEqual(len(rows), 4)
            copied = [row for row in rows if row.get("resumed")]
            fresh = [row for row in rows if not row.get("resumed")]
            self.assertEqual(len(copied), 2)
            self.assertEqual(len(fresh), 2)
            self.assertEqual(first.read_bytes(), source_bytes)
            for cond in ("baseline", "treatment"):
                denom = [row for row in rows if row["condition"] == cond]
                self.assertEqual(len(denom), 2)

    def test_outcome_resume_rejects_order_and_duplicate_mismatch(self) -> None:
        main = self.outcome["main"]
        task = {"id": "O1", "request": "Route this", "heldout": False,
                "expected": ["direct"]}
        fake_obs = {"status": "ok", "output": "route: direct", "duration": 0.1}
        with tempfile.TemporaryDirectory(prefix="outcome-mismatch-") as raw:
            argv1 = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                     "--trials", "1"]
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=lambda *_: [task],
                            observe=lambda *_args, **_kwargs: dict(fake_obs)), \
                    patch.object(sys, "argv", argv1):
                self.assertEqual(main(), 0)
            first = sorted(Path(raw).glob("*.json"))[0]
            # Different order policy must refuse.
            argv2 = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                     "--trials", "1", "--order", "fixed",
                     "--resume-from", str(first)]
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=lambda *_: [task]), \
                    patch.object(sys, "argv", argv2):
                self.assertEqual(main(), 2)
            # Duplicate trial identities in the source must refuse.
            dup = json.loads(first.read_text())
            dup["trials"].append(dict(dup["trials"][0]))
            dup_path = Path(raw) / "dup.json"
            dup_path.write_text(json.dumps(dup))
            argv3 = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                     "--trials", "1", "--resume-from", str(dup_path)]
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=lambda *_: [task]), \
                    patch.object(sys, "argv", argv3):
                self.assertEqual(main(), 2)
            self.assertEqual(len(list(Path(raw).glob("*.json"))), 2)

    def test_confirm_only_tasks_excluded_from_sweeps(self) -> None:
        # confirm_only runs solely via explicit --task; ordinary and
        # --heldout sweeps must never spend that budget. Explicit --task
        # still reaches both confirmation and ordinary tasks.
        main = self.outcome["main"]
        regular = {"id": "O1", "request": "Route this", "heldout": False,
                   "expected": ["direct"]}
        confirm = {"id": "C1", "request": "Confirm this", "heldout": True,
                   "confirm_only": True, "expected": ["direct"]}
        fake_obs = {"status": "ok", "output": "route: direct", "duration": 0.1}
        loader = lambda skill, heldout: [t for t in (regular, confirm)
                                         if t["heldout"] == heldout]
        with tempfile.TemporaryDirectory(prefix="outcome-confirm-") as raw:
            base = dict(RESULTS=raw, AGENTS={"fake": {"bin": sys.executable}},
                        load_tasks=loader,
                        observe=lambda *_args, **_kwargs: dict(fake_obs))
            with patch.dict(main.__globals__, **base), \
                    patch.object(sys, "argv", ["eval-outcome", "--skill", "concierge",
                                               "--agent", "fake", "--trials", "1"]):
                self.assertEqual(main(), 0)
            with patch.dict(main.__globals__, **base), \
                    patch.object(sys, "argv", ["eval-outcome", "--skill", "concierge",
                                               "--agent", "fake", "--trials", "1",
                                               "--heldout"]):
                # Heldout sweep holds only the confirm task -> nothing to run.
                self.assertEqual(main(), 2)
            paths = list(Path(raw).glob("*.json"))
            self.assertEqual(len(paths), 1)
            record = json.loads(paths[0].read_text())
            self.assertEqual({row["task"] for row in record["trials"]}, {"O1"})
            with patch.dict(main.__globals__, **base), \
                    patch.object(sys, "argv", ["eval-outcome", "--skill", "concierge",
                                               "--agent", "fake", "--trials", "1",
                                               "--task", "C1"]):
                self.assertEqual(main(), 0)
            paths = sorted(Path(raw).glob("*.json"))
            self.assertEqual(len(paths), 2)
            record = json.loads(paths[1].read_text())
            self.assertEqual({row["task"] for row in record["trials"]}, {"C1"})

    def test_provenance_untracked_digest(self) -> None:
        from eval_isolation import repo_provenance
        with tempfile.TemporaryDirectory(prefix="provenance-") as raw:
            repo = Path(raw)
            run("git", "init", "-q", raw)
            run("git", "-C", raw, "config", "user.email", "t@t")
            run("git", "-C", raw, "config", "user.name", "t")
            (repo / "tracked.txt").write_text("tracked")
            run("git", "-C", raw, "add", "-A")
            run("git", "-C", raw, "commit", "-qm", "init")
            (repo / "scripts").mkdir()
            (repo / "scripts/eval_guard.py").write_text("guard")
            (repo / "scripts/eval_isolation.py").write_text("isolation")
            (repo / "notes.txt").write_text("candidate content sentinel-xyz")
            first = repo_provenance(str(repo), str(repo / "scripts/eval-outcome"))
            self.assertTrue(first["untracked"]["available"])
            self.assertTrue(first["working_tree_dirty"])
            (repo / "notes.txt").write_text("changed content sentinel-abc")
            second = repo_provenance(str(repo), str(repo / "scripts/eval-outcome"))
            self.assertNotEqual(first["untracked"]["digest"], second["untracked"]["digest"])
            dump = json.dumps(second)
            self.assertNotIn("sentinel-xyz", dump)
            self.assertNotIn("sentinel-abc", dump)
            self.assertNotIn(str(repo), dump)
            self.assertEqual(first["runner_deps"]["eval_guard.py"],
                             second["runner_deps"]["eval_guard.py"])

    def test_task_filter_selects_single_confirmation_task(self) -> None:
        # Phase 4: C1 confirmation tasks run only via --task, never in sweeps.
        main = self.outcome["main"]
        regular = {"id": "O1", "request": "Route this", "heldout": False,
                   "expected": ["direct"]}
        confirm = {"id": "C1", "request": "Confirm this", "heldout": True,
                   "expected": ["direct"]}
        fake_obs = {"status": "ok", "output": "route: direct", "duration": 0.1}
        loader = lambda skill, heldout: [t for t in (regular, confirm)
                                         if t["heldout"] == heldout]
        with tempfile.TemporaryDirectory(prefix="outcome-task-") as raw:
            argv = ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                    "--trials", "1", "--task", "C1"]
            with patch.dict(main.__globals__, RESULTS=raw,
                            AGENTS={"fake": {"bin": sys.executable}},
                            load_tasks=loader,
                            observe=lambda *_args, **_kwargs: dict(fake_obs)), \
                    patch.object(sys, "argv", argv):
                self.assertEqual(main(), 0)
            paths = list(Path(raw).glob("*.json"))
            self.assertEqual(len(paths), 1)
            record = json.loads(paths[0].read_text())
            self.assertEqual({row["task"] for row in record["trials"]}, {"C1"})
            self.assertEqual(len(record["trials"]), 2)
            self.assertEqual(record["provenance"]["settings"]["task_filter"], "C1")
            for argv in (["eval-outcome", "--skill", "concierge", "--agent", "fake",
                          "--trials", "1", "--task", "Z9"],
                         ["eval-outcome", "--skill", "concierge", "--agent", "fake",
                          "--trials", "1", "--task", "O1", "--heldout"]):
                with self.subTest(argv=argv):
                    with patch.dict(main.__globals__, RESULTS=raw,
                                    AGENTS={"fake": {"bin": sys.executable}},
                                    load_tasks=loader), \
                            patch.object(sys, "argv", argv):
                        self.assertEqual(main(), 2)

    def test_dry_runs_accept_model_without_invocation(self) -> None:
        model = "opencode/muse-spark-1.3-contributor-free"
        result = run(str(SCRIPTS / "eval-trigger"), "--dry-run",
                     "--suite", "cases", "--max-cases", "1", "--model", model)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        result = run(str(SCRIPTS / "eval-workflow"), "--list", "--model", model)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        # eval-outcome checks that the agent binary exists before it reads
        # --resume-from, so give it a stub opencode; otherwise the test fails
        # with exit 3 (UNAVAILABLE) on any machine without opencode installed.
        with tempfile.TemporaryDirectory() as bin_dir:
            stub = Path(bin_dir) / "opencode"
            stub.write_text("#!/bin/sh\necho stub\n")
            stub.chmod(0o755)
            env = {**os.environ, "PATH": bin_dir + os.pathsep + os.environ["PATH"]}
            result = subprocess.run(
                [str(SCRIPTS / "eval-outcome"), "--skill", "concierge",
                 "--agent", "opencode", "--trials", "1",
                 "--resume-from", "/nonexistent.json"],
                cwd=ROOT, capture_output=True, text=True, env=env)
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)


if __name__ == "__main__":
    unittest.main(verbosity=2)
